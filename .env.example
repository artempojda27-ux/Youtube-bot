# YouTube Data API v3 — console.cloud.google.com → включить "YouTube Data API v3" → API key
YOUTUBE_API_KEY=

# YouTube Analytics API (статистика ТВОЕГО канала — приватные данные, нужен OAuth)
# 1. Тот же проект в Google Cloud Console → включить "YouTube Analytics API"
# 2. Credentials → OAuth client ID → тип Web application
# 3. Redirect URI: http://localhost:3000/api/auth/google/callback (на проде — свой домен)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Появится после разового прохода через /api/auth/google в браузере:
GOOGLE_REFRESH_TOKEN=

# Claude (генерация сценария)
ANTHROPIC_API_KEY=

# HeyGen — видео-генерация (опционально, BYOK)
HEYGEN_API_KEY=
